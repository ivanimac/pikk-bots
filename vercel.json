{
  "buildCommand": "mkdir -p .vercel/output/static && echo 'pikk-bots v0.1.0' > .vercel/output/static/index.html",
  "outputDirectory": ".vercel/output/static",
  "installCommand": "pnpm install --frozen-lockfile",
  "rewrites": [
    { "source": "/webhooks/(.*)", "destination": "/api" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/admin/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/api" }
  ],
  "crons": [
    {
      "path": "/api/cron/purge-messages",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/health-check",
      "schedule": "0 4 * * *"
    }
  ]
}
